# --- Bridge HTTP server ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# --- Discourse webhook auth (set the same value in Admin UI) ---
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Bot identity & access control ---
# Username under which the bridge posts replies (must match DISCOURSE_USERNAME in discourse.env).
BOT_USERNAME=cursor_bot
# Comma-separated list of Discourse usernames whose @mentions the bot will react to.
# Empty = react to anyone (NOT recommended, since cursor-agent runs with --force).
ALLOWED_USERNAMES=admin

# --- Cursor agent ---
# Absolute path to the cursor-agent binary.
CURSOR_AGENT_BIN=~/.local/bin/cursor-agent
# Workspace the agent runs in (sees .cursor/rules, MCP, repo files).
WORKSPACE=~/workspace
# Model passed via --model. Leave empty to use the CLI default.
CURSOR_MODEL=
# Hard timeout for one agent run, seconds.
AGENT_TIMEOUT_SEC=180

# --- Discourse env ---
# Path to the existing discourse.env file with DISCOURSE_URL / DISCOURSE_API_KEY / DISCOURSE_USERNAME.
DISCOURSE_ENV_FILE=~/workspace/discourse.env

# --- Context assembly ---
# How many trailing posts of a topic to include in the prompt.
CONTEXT_POSTS=10
# Max length of a single post raw included in the prompt (bytes).
MAX_POST_BYTES=8192

# --- Storage ---
STATE_FILE=./state.json
LOG_DIR=./logs

# --- OpenAI-compatible /v1/chat/completions (см. openai_endpoint.py) ---
# Bearer-токен; если пусто — эндпоинт отдаёт 503 (выключен).
BRIDGE_OPENAI_API_KEY=
# Песочница, в которой работает cursor-agent для OpenAI-запросов.
CURSOR_OPENAI_WORKSPACE=/tmp/cursor-openai-sandbox
# Таймаут на один OpenAI-запрос, сек. По умолчанию = AGENT_TIMEOUT_SEC.
BRIDGE_OPENAI_TIMEOUT_SEC=
# Лимит длины собранного prompt (символы).
BRIDGE_OPENAI_MAX_PROMPT_CHARS=200000
# Allowlist слагов, которые клиент может прислать в поле `model`. Эти строки
# дословно уезжают в `cursor-agent --model <slug>`. Пусто или `*` =
# дефолтный список (auto, composer-2, gpt-5, gpt-5-codex,
# claude-sonnet-4, claude-sonnet-4-thinking). Пустое поле `model` или
# `default` = модель из CURSOR_MODEL выше.
BRIDGE_OPENAI_ALLOWED_MODELS=
